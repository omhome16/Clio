# Clio configuration — copy to .env (or point CLIO_ENV_FILE at it) and fill in.
# Provider: gemini (default) | groq | ollama (local, no key).
CLIO_PROVIDER=gemini

# Cloud models via Gemini (https://aistudio.google.com/apikey):
CLIO_CHEAP_MODEL=gemini-2.5-flash
CLIO_FRONTIER_MODEL=gemini-2.5-flash
GEMINI_API_KEY=

# Alternative cloud models via Groq (https://console.groq.com/keys):
# CLIO_PROVIDER=groq
# CLIO_CHEAP_MODEL=llama-3.3-70b-versatile
# CLIO_FRONTIER_MODEL=llama-3.3-70b-versatile
# GROQ_API_KEY=

# Fallback: local models via Ollama (https://ollama.com/library/qwen2.5-coder).
# Set CLIO_PROVIDER=ollama and pull the model first, e.g. `ollama pull qwen2.5-coder:3b`.
# Keep the context short on small GPUs: `setx OLLAMA_CONTEXT_LENGTH 8192`.
# CLIO_PROVIDER=ollama
# CLIO_CHEAP_MODEL=qwen2.5-coder:3b
# CLIO_FRONTIER_MODEL=qwen2.5-coder:3b
# CLIO_OLLAMA_BASE_URL=http://localhost:11434/v1

# Optional: restrict cloning to specific hosts (comma-separated). Empty = any https host.
# CLIO_ALLOWED_HOSTS=github.com,gitlab.com