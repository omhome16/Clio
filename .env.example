# Clio configuration — copy to .env (or point CLIO_ENV_FILE at it) and fill in.
# Provider: gemini or groq (a key is required; unset key = loud failure).
CLIO_PROVIDER=gemini

# Optional model overrides (free tier defaults).
# CLIO_CHEAP_MODEL=gemini-2.5-flash
# CLIO_FRONTIER_MODEL=gemini-2.5-flash

# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# https://console.groq.com/keys
GROQ_API_KEY=
